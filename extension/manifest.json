{
  "manifest_version": 3,
  "name": "SmartLife Quick Notes & Web Clipper",
  "version": "1.0.0",
  "description": "Ghi chú nhanh, bôi đen lưu trích dẫn web & đồng bộ dữ liệu thời gian thực với SmartLife App",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Mở SmartLife Quick Note (Alt+Shift+N)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "notifications",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://localhost/*",
    "*://127.0.0.1/*",
    "*://*.vercel.app/*",
    "https://toanywkdbhfqdfvtrrzm.supabase.co/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Command+Shift+N"
      },
      "description": "Mở nhanh cửa sổ ghi chú SmartLife"
    }
  }
}
