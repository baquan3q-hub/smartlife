{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartLife",
  "version": "0.1.0",
  "identifier": "com.smartlife.desktop",
  "build": {
    "frontendDist": "https://smartlife.courses/"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "SmartLife",
    "shortDescription": "SmartLife — Sticky Notes, Kanban, tài chính & AI",
    "longDescription": "SmartLife cho Windows: ghi chú dán nổi trên màn hình, đồng bộ với web và điện thoại, AI tách việc thành task.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
