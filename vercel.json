{
    "functions": {
        "api/telegram.js": {
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/api/gemini",
            "destination": "/api/gemini.js"
        },
        {
            "source": "/api/send-email",
            "destination": "/api/send-email.js"
        },
        {
            "source": "/api/cron-check-emails",
            "destination": "/api/cron-check-emails.js"
        },
        {
            "source": "/api/v1/ai/context",
            "destination": "/api/v1/context"
        },
        {
            "source": "/api/v1/ai/insights",
            "destination": "/api/v1/insights"
        },
        {
            "source": "/api/v1/finance/overview",
            "destination": "/api/v1/finance"
        },
        {
            "source": "/api/v1/finance/options",
            "destination": "/api/v1/finance?action=options"
        },
        {
            "source": "/api/v1/finance/transactions/:id",
            "destination": "/api/v1/finance?action=transactions&id=:id"
        },
        {
            "source": "/api/v1/finance/transactions",
            "destination": "/api/v1/finance?action=transactions"
        },
        {
            "source": "/api/v1/openapi.json",
            "destination": "/api/v1/openapi"
        },
        {
            "source": "/api/v1/tasks/reorder",
            "destination": "/api/v1/tasks?action=reorder"
        },
        {
            "source": "/api/v1/tasks/:id",
            "destination": "/api/v1/tasks?id=:id"
        },
        {
            "source": "/api/v1/(.*)",
            "destination": "/api/v1/not-found"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}